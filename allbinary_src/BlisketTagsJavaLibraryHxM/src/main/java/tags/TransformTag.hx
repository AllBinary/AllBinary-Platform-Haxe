import tags.transform.info.TransformInfoTag;

class TransformTag extends TransformInfoTag {
    public final logUtil : LogUtil = LogUtil.getInstance();
    public function new() {
        super(new ViewHelperFactory());
        if (org.allbinary.logic.communication.log.config.type.LogConfigTypes.LOGGING.contains(org.allbinary.logic.communication.log.config.type.LogConfigTypeFactory.getInstance().JSPTAG)) {
            this.logUtil.putF(this.commonStrings.START, this, this.commonStrings.CONSTRUCTOR);
        }
    }

    // Java overloaded constructor: Haxe allows one constructor
    public function new(tagHelperFactoryInterface : TagHelperFactoryInterface) {
        super(tagHelperFactoryInterface);
        if (org.allbinary.logic.communication.log.config.type.LogConfigTypes.LOGGING.contains(org.allbinary.logic.communication.log.config.type.LogConfigTypeFactory.getInstance().JSPTAG)) {
            this.logUtil.putF(this.commonStrings.START, this, this.commonStrings.CONSTRUCTOR);
        }
    }

    // throws Exception
    public function view() : String {
        try {
            var result : String = (cast Type.getClass(this.getHelper()).getMethod("view", null).invoke(this.getHelper(), null) : String);
            return result;
        } catch (e : haxe.Exception) {
            if (org.allbinary.logic.communication.log.config.type.LogConfigTypes.LOGGING.contains(org.allbinary.logic.communication.log.config.type.LogConfigTypeFactory.getInstance().JSPTAGERROR)) {
                this.logUtil.put(this.commonStrings.EXCEPTION, this, "view()", e);
            }
            throw e;
        }
    }

    // throws JspTagException
    public function doStartTag() : Int {
        try {
            if (org.allbinary.logic.communication.log.config.type.LogConfigTypes.LOGGING.contains(org.allbinary.logic.communication.log.config.type.LogConfigTypeFactory.getInstance().JSPTAG)) {
                this.logUtil.putF("Creating with: \n" + this.getPropertiesHashMap().toString(), this, tagStrings.DO_START_TAG);
            }
            if (org.allbinary.logic.communication.log.config.type.LogConfigTypes.LOGGING.contains(org.allbinary.logic.communication.log.config.type.LogConfigTypeFactory.getInstance().JSPTAG)) {
                var stringBuffer : StringMaker = new StringMaker();
                stringBuffer.append("ViewTag Start For: ");
                stringBuffer.append(this.getName());
                stringBuffer.append("\nViewFile: ");
                stringBuffer.append(this.getObjectFile());
                this.logUtil.putF(stringBuffer.toString(), this, tagStrings.DO_START_TAG);
            }
            this.setHelper();
            pageContext.getOut().print(this.view());
            if (org.allbinary.logic.communication.log.config.type.LogConfigTypes.LOGGING.contains(org.allbinary.logic.communication.log.config.type.LogConfigTypeFactory.getInstance().JSPTAG)) {
                this.logUtil.putF("Tag End", this, tagStrings.DO_START_TAG);
            }
            return SKIP_BODY;
        } catch (e : LicensingException) {
            AbResponseHandler.sendJspTagLicensingRedirect(this.pageContext, e);
            return SKIP_BODY;
        } catch (e : haxe.Exception) {
            AbResponseHandler.sendJspTagRedirect(this.pageContext, e);
            return SKIP_BODY;
        }
    }

