<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <groupId>org.allbinary.game</groupId>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>AllBinaryGameClientNoPlatformJavaDocApplicationHaxe</artifactId>
    <packaging>jar</packaging>
    <!-- AllBinary Platform Version Start -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->

    <name>AllBinaryGameClientNoPlatformJavaDocApplicationHaxe</name>
    <url>http://www.allbinary.com/</url>

    <properties>
        <haxe.executable>C:/HaxeToolkit/haxe/haxe.exe</haxe.executable>
        <!-- Type checks every module with the eval target. Other targets such as cpp need the target library from haxelib -->
        <haxe.target>--interp</haxe.target>
        <haxe.dependency.directory>${project.build.directory}/haxe-dependencies/META-INF/haxe</haxe.dependency.directory>
        <!-- The Java runtime (java.* as jre.*) that every Haxe build has on its class path like the Python RUNTIME_SOURCE -->
        <haxe.runtime.directory>G:/mnt/bc/mydev/workhaxe/j2me/J2SEForHaxeLibraryHxM/src/main/java</haxe.runtime.directory>
        <buildLabel>${project.version}</buildLabel>
    </properties>
    
    <dependencies>
                
        <dependency>
            <groupId>org.graph</groupId>
            <artifactId>GraphBaseJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>
                
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>OpenGLNoneJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-midpHaxe</artifactId>
            <version>2.0.4</version>
        </dependency>
        <!--
        Public microemu
        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-midpHaxe</artifactId>
            <version>2.0.4</version>
        </dependency>
        Custom microemu
        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-midpHaxe</artifactId>
            <version>3.0.0-SNAPSHOT</version>
            <optional>true</optional>
        </dependency>
        -->
        
        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-jsr-135Haxe</artifactId>
            <version>2.0.4</version>
            <optional>true</optional>
        </dependency>        
        <!--
        Public microemu
        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-jsr-135Haxe</artifactId>
            <version>2.0.4</version>
            <optional>true</optional>
        </dependency>
        Custom microemu
        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-jsr-135Haxe</artifactId>
            <version>3.0.0-SNAPSHOT</version>
            <optional>true</optional>
        </dependency>
        -->
        
    </dependencies>
 
    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-haxe-dependencies</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeTypes>jar</includeTypes>
                            <excludeClassifiers>sources</excludeClassifiers>
                            <includes>META-INF/haxe/**</includes>
                            <outputDirectory>${project.build.directory}/haxe-dependencies</outputDirectory>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-haxe-sources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/haxe</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/java</directory>
                                    <includes>
                                        <include>**/*.hx</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-haxe-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${haxe.executable}</executable>
                            <workingDirectory>${project.basedir}/src/main/java</workingDirectory>
                            <arguments>
                                <argument>-cp</argument>
                                <argument>.</argument>
                                <argument>-cp</argument>
                                <argument>${haxe.dependency.directory}</argument>
                                <argument>-cp</argument>
                                <argument>${haxe.runtime.directory}</argument>
                                <argument>--macro</argument>
                                <argument>include('', true, null, ['.'])</argument>
                                <argument>${haxe.target}</argument>
                                <argument>--no-output</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>



            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>2.8.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>

