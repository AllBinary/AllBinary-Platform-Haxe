    public var SCALE : Int = 10000;
    // throws Exception
    public function antiTan(dx : Int, dy : Int) : Int {
        final MAX_VALUE : haxe.Int64 = (haxe.Int64.ofInt(Integer.MAX_VALUE));
        final MIN_VALUE : haxe.Int64 = (haxe.Int64.ofInt(Integer.MIN_VALUE));
        var ratio : haxe.Int64 = (MAX_VALUE - 1);
        if (dy != 0) {
            var dxl : haxe.Int64 = (haxe.Int64.ofInt(dx));
            ratio = haxe.Int64.ofInt(this.SCALE) * dxl / haxe.Int64.ofInt(dy);
            if (dx <= 0 && dy < 0) {
                ratio = this.mathUtil.abslong(ratio);
            }
        }
        if ((dx >= 0 && dy < 0)) {
            {
                var index : Int = 180;
                while (index > 90) {
                if (ratio <= this.noDecimalTan[index]) {
                    if (ratio > this.noDecimalTan[index - 1]) {
                        return (index);
                    } else if (this.noDecimalTan[index - 1] == MAX_VALUE && ratio > MIN_VALUE) {
                        return (index);
                    }
                }
                    index--;
                }
            }
        } else if ((dx < 0 && dy <= 0)) {
            {
                var index : Int = 270;
                while (index > 180) {
                if (ratio < this.noDecimalTan[index] && ratio >= this.noDecimalTan[index - 1]) {
                    return (index);
                }
                    index--;
                }
            }
        } else if ((dx < 0 && dy > 0)) {
            {
                var index : Int = (this.noDecimalTan.length - 1);
                while (index > 270) {
                if (ratio < this.noDecimalTan[index]) {
                    if (ratio >= this.noDecimalTan[index - 1]) {
                        return (index);
                    } else if (this.noDecimalTan[index - 1] == MAX_VALUE && ratio >= MIN_VALUE) {
                        return (index);
                    }
                }
                    index--;
                }
            }
        } else if ((dx >= 0 && dy >= 0)) {
            {
                var index : Int = 90;
                while (index > 0) {
                if (ratio < this.noDecimalTan[index] && ratio >= this.noDecimalTan[index - 1]) {
                    return (index);
                }
                    index--;
                }
            }
        }
        final stringBuffer : StringMaker = new StringMaker();
        stringBuffer.append("Invalid Ratio: ");
        stringBuffer.appendlong(ratio);
        stringBuffer.append(CommonSeps.getInstance().SPACE);
        stringBuffer.append(PositionStrings.getInstance().DX_LABEL);
        stringBuffer.appendint(dx);
        stringBuffer.append(CommonSeps.getInstance().SPACE);
        stringBuffer.append(PositionStrings.getInstance().DX_LABEL);
        stringBuffer.appendint(dy);
        throw new jre.lang.JavaException(Std.string(stringBuffer));
    }

