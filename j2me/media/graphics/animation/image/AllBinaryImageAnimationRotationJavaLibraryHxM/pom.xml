<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.allbinary.animation</groupId>
  <artifactId>AllBinaryImageAnimationRotationJavaLibraryHaxe</artifactId>
  <packaging>jar</packaging>
  <!-- AllBinary Platform Version Start -->
  <version>1.0.0-SNAPSHOT</version>
  <!-- AllBinary Platform Version End -->

  <name>AllBinaryImageAnimationRotationJavaLibraryHaxe</name>
  <url>http://www.allbinary.com/</url>
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>



    <properties>
        <haxe.executable>C:/HaxeToolkit/haxe/haxe.exe</haxe.executable>
        <!-- Type checks every module with the eval target. Other targets such as cpp need the target library from haxelib -->
        <haxe.target>--interp</haxe.target>
        <haxe.dependency.directory>${project.build.directory}/haxe-dependencies/META-INF/haxe</haxe.dependency.directory>
        <!-- The Java runtime (java.* as jre.*) that every Haxe build has on its class path like the Python RUNTIME_SOURCE -->
        <haxe.runtime.directory>G:/mnt/bc/mydev/workhaxe/j2me/J2SEForHaxeLibraryHxM/src/main/java</haxe.runtime.directory>
    </properties>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LoggingJ2MEAllHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LogJ2MEJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>J2SEForJ2MEJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>OpenGLNoneJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>OpenGLNoneOtherJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>ImageCacheJ2MEJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary.media.image</groupId>
            <artifactId>ImageJ2MEJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>RotationAnimationJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

        </dependency>
        
        <dependency>
            <groupId>org.allbinary.animation</groupId>
            <artifactId>AllBinaryImageAnimationJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

        </dependency>        
    
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>VectorJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

        </dependency>
    
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>VectorAnimationJ2MEJavaLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

        </dependency>
    
        <dependency>
            <groupId>org.allbinary.cache</groupId>
            <artifactId>AllBinaryCacheLibraryHaxe</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

        </dependency>
            
        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-midpHaxe</artifactId>
            <version>2.0.4</version>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <build>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-haxe-dependencies</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeTypes>jar</includeTypes>
                            <excludeClassifiers>sources</excludeClassifiers>
                            <includes>META-INF/haxe/**</includes>
                            <outputDirectory>${project.build.directory}/haxe-dependencies</outputDirectory>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                    <!-- Classes more than one dependency has (stubs, platform variants): the copy with the most members is written again last -->
                    <execution>
                        <id>unpack-haxe-winners</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <markersDirectory>${project.build.directory}/haxe-winner-markers</markersDirectory>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.allbinary</groupId>
                                    <artifactId>J2SEForJ2MEJavaLibraryHaxe</artifactId>
                                    <version>1.0.0-SNAPSHOT</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/haxe-dependencies</outputDirectory>
                                    <includes>META-INF/haxe/org/allbinary/AndroidUtil.hx,META-INF/haxe/org/allbinary/AvianUtil.hx,META-INF/haxe/org/allbinary/game/displayable/canvas/NullDisplayable.hx,META-INF/haxe/org/allbinary/J2MEUtil.hx,META-INF/haxe/org/allbinary/logic/math/J2SEMath.hx,META-INF/haxe/org/allbinary/persistance/PlatformRecordIdUtil.hx,META-INF/haxe/org/allbinary/PostGameCommandFactory.hx,META-INF/haxe/org/allbinary/TsUtil.hx</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.allbinary</groupId>
                                    <artifactId>BaseMathLibraryHaxe</artifactId>
                                    <version>1.0.0-SNAPSHOT</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/haxe-dependencies</outputDirectory>
                                    <includes>META-INF/haxe/org/allbinary/math/PositionStrings.hx</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.microemu</groupId>
                                    <artifactId>microemu-midpHaxe</artifactId>
                                    <version>2.0.4</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/haxe-dependencies</outputDirectory>
                                    <includes>META-INF/haxe/javax/microedition/lcdui/NullCanvas.hx</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.allbinary</groupId>
                                    <artifactId>NullJ2MELibraryHaxe</artifactId>
                                    <version>1.0.0-SNAPSHOT</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/haxe-dependencies</outputDirectory>
                                    <includes>META-INF/haxe/javax/microedition/lcdui/NullCommandListener.hx,META-INF/haxe/javax/microedition/lcdui/NullImage.hx</includes>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.allbinary</groupId>
                                    <artifactId>PersonalComputerSystemJavaLibraryHaxe</artifactId>
                                    <version>1.0.0-SNAPSHOT</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/haxe-dependencies</outputDirectory>
                                    <includes>META-INF/haxe/org/allbinary/logic/system/hardware/HardwareFactory.hx</includes>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>copy-haxe-sources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/haxe</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/src/main/java</directory>
                                    <includes>
                                        <include>**/*.hx</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-haxe-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${haxe.executable}</executable>
                            <workingDirectory>${project.basedir}/src/main/java</workingDirectory>
                            <arguments>
                                <!-- Haxe uses the last class path that has a module: the sources of this project win over a dependency like javac -->
                                <argument>-cp</argument>
                                <argument>${haxe.runtime.directory}</argument>
                                <argument>-cp</argument>
                                <argument>${haxe.dependency.directory}</argument>
                                <argument>-cp</argument>
                                <argument>.</argument>
                                <argument>--macro</argument>
                                <argument>include('', true, null, ['.'])</argument>
                                <argument>${haxe.target}</argument>
                                <argument>--no-output</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>

    </build>

</project>

